working-directory = /Users/vegardx/src
macos-titlebar-style = tabs
window-decoration = false
window-padding-x = 10
window-padding-y = 10
shell-integration-features = no-title
maximize = true
theme = Catppuccin Macchiato
font-family = "Menlo"
font-size = 16

# Keybinds
keybind = shift+enter=text:\x1b\r
keybind = global:cmd+\=toggle_quick_terminal
keybind = cmd+enter=toggle_split_zoom
keybind = cmd+t=new_split:auto
keybind = cmd+shift+left=new_split:left
keybind = cmd+shift+right=new_split:right
keybind = cmd+shift+up=new_split:up
keybind = cmd+shift+down=new_split:down
keybind = cmd+left=goto_split:left
keybind = cmd+right=goto_split:right
keybind = cmd+up=goto_split:up
keybind = cmd+down=goto_split:down
