[core]
	pager = less
	editor = nano

[pull]
	rebase = true

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://dnb.ghe.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

[includeIf "gitdir:~/src/github.com/"]
	path = ~/.config/git/config-github

[includeIf "gitdir:~/src/dnb.ghe.com/"]
	path = ~/.config/git/config-dnb
[init]
	defaultBranch = main
